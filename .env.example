# Port exposé sur l'hôte
PORT=5080
# Purge automatique des téléversements et rendus (heures, 0 = jamais)
RETENTION_HOURS=48
# Taille cumulée maximale d'un téléversement (Mo)
MAX_UPLOAD_MB=1024
# Rendus simultanés (1 par cœur physique est un bon point de départ)
MAX_CONCURRENT_JOBS=2
# Fonds de carte en ligne : 0 pour un fonctionnement totalement hors ligne
TILES_ENABLED=1
MAX_TILE_ZOOM=17
# Autoriser un serveur de tuiles sur IP privée (ex. votre propre instance)
ALLOW_PRIVATE_TILE_HOSTS=0
LOG_LEVEL=INFO
